{
  "name": "@proseline-editor/react",
  "version": "0.1.0",
  "description": "React components for the Proseline prose editor",
  "license": "MIT",
  "author": "Proseline contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proseline-editor/proseline.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/proseline-editor/proseline#readme",
  "bugs": "https://github.com/proseline-editor/proseline/issues",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/AndriiSlavnov"
  },
  "keywords": [
    "editor",
    "prose",
    "writing",
    "react",
    "tiptap",
    "prosemirror"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
