  "scripts": {
    "build": "tsc -b && cp ../react/src/theme.css dist/theme.css",
    "test": "vitest run"
  },
  "dependencies": {
    "@proseline-editor/core": "workspace:^"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@vue/compiler-sfc": "^3.5.44",
    "vue": "^3.5.44"
  }
