{
  "name": "@proseline-editor/sync",
  "version": "0.1.1",
  "description": "Reliable Yjs sync for the Proseline prose editor: provider engine, collaboration feature, server helpers",
  "license": "MIT",
  "author": "Proseline contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proseline-editor/proseline.git",
    "directory": "packages/sync"
  },
  "homepage": "https://github.com/proseline-editor/proseline#readme",
  "bugs": "https://github.com/proseline-editor/proseline/issues",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/AndriiSlavnov"
  },
  "keywords": [
    "editor",
    "collaboration",
    "yjs",
    "crdt",
    "tiptap",
    "offline"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@proseline-editor/core": "workspace:^",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "y-protocols": "^1.0.7"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/html": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "happy-dom": ">=20.8.9",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/html": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/html": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "happy-dom": "^21.0.3",
    "yjs": "^13.6.33"
  }
}
